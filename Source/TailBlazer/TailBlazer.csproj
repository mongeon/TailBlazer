<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>tailblazer.ico</ApplicationIcon>
    <Version>0.9.5</Version>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="tailblazer.ico" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Themes\ComboBox.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="tailblazer.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="tailblazer.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dragablz" />
    <PackageReference Include="DynamicData" />
    <PackageReference Include="log4net" />
    <PackageReference Include="MaterialDesignExtensions" />
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="ReactiveUI.WPF" />
    <PackageReference Include="StructureMap" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TailBlazer.Domain\TailBlazer.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Log4Net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>
